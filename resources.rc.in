// Windows-ресурсы SmartClip: иконка исполняемого файла (Проводник, панель
// задач, трей) и VERSIONINFO (свойства файла → «Подробности»).
//
// Файл генерируется из этого шаблона на этапе configure (см. CMakeLists.txt):
// @SMARTCLIP_RC_*@ подставляет версия из файла VERSION, а путь к иконке —
// абсолютный. Редактируй шаблон, а не сгенерированный resources.rc.

#include <windows.h>

// Иконка приложения (7 размеров, собрана из icons/icon.png).
IDI_ICON1 ICON "@SMARTCLIP_RC_ICON@"

// Версия видна в свойствах SmartClip.exe на вкладке «Подробности».
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    @SMARTCLIP_RC_MAJOR@,@SMARTCLIP_RC_MINOR@,@SMARTCLIP_RC_PATCH@,0
 PRODUCTVERSION @SMARTCLIP_RC_MAJOR@,@SMARTCLIP_RC_MINOR@,@SMARTCLIP_RC_PATCH@,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Aleksey Zhmikhov"
            VALUE "FileDescription",  "SmartClip - Clipboard History Manager"
            VALUE "FileVersion",      "@SMARTCLIP_VERSION@"
            VALUE "InternalName",     "SmartClip"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "SmartClip.exe"
            VALUE "ProductName",      "SmartClip"
            VALUE "ProductVersion",   "@SMARTCLIP_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
